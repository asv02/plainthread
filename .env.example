# Public (browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_SITE_URL=https://plainthread.in

# Server only — never commit real values
SUPABASE_SERVICE_ROLE_KEY=
# live | test. Production defaults to live. Live keys start with rzp_live_.
RAZORPAY_MODE=live
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Live dashboard webhook secret (different from Test). URL: https://plainthread.in/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
ADMIN_PASSWORD=
# Required on Vercel. Cron sends Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
RESEND_API_KEY=
EMAIL_FROM="Plain Thread <hello@plainthread.in>"
ORDER_NOTIFY_EMAIL=hello@plainthread.in
# Checkout OTP. Falls back to ADMIN_PASSWORD if unset.
OTP_SECRET=
# Optional SMS OTP (India DLT template required for MSG91).
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Or Twilio:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# Commerce
SHIPPING_RUPEES=0
# COD is off. Set true only if you want cash on delivery again.
COD_ENABLED=false
COD_FEE_PAISE=0
# Magic Checkout dashboard URLs (public, no auth):
#   /api/razorpay/shipping-info
#   /api/razorpay/promotions
#   /api/razorpay/promotions/apply
# Webhook extra events: payment.pending, order.placed
STOCK_HOLD_MINUTES=5
NEXT_PUBLIC_GST_RATE_PERCENT=5
GST_RATE_PERCENT=5
NEXT_PUBLIC_GST_INCLUSIVE=false
GST_INCLUSIVE=false
GST_ORIGIN_STATE=Haryana

# Local only. Never true on Vercel/production.
ALLOW_SIMULATED_PAYMENTS=false

# debug | info | error. Default: debug in development, info in production.
LOG_LEVEL=info

# Server-only Meta Conversions API. Never prefix with NEXT_PUBLIC_.
# Put real values in .env.local / hosting secrets — never commit them.
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v25.0
# Staging only. Must stay empty in production.
META_CAPI_TEST_EVENT_CODE=
META_CAPI_WORKER_SECRET=